{
    "name": "magemaclean/m2-core",
    "description": "MageMaclean Core module for MageMaclean extensions",
    "type": "magento2-module",
    "version": "1.0.5",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "103.0.*||104.0.*"
    },
    "authors": [
        {
            "name": "MageMaclean",
            "email": "support@magemaclean.com",
            "homepage": "https://magemaclean.com",
            "role": "Leader"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageMaclean\\Core\\": ""
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.44",
        "magento/magento-coding-standard": "^41",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1"
    }
}
